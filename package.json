{
  "name": "convertecaixa",
  "type": "module",
  "version": "1.0.0",
  "description": "Case Converter by ConverteCaixa - Bilingual text case conversion website",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "build": "astro build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name convertecaixa",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.1.7",
    "astro": "^7.3.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "vitest": "^3.2.1",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
