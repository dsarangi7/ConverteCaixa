---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';

const title = '404 - Page Not Found';
const description = 'The page you are looking for could not be found.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  noindex={true}
>
  <section class="max-w-[600px] mx-auto px-6 py-24 text-center">
    <h1 class="font-display-xl text-ink mb-4">404</h1>
    <p class="font-heading-lg text-ink mb-2">Page not found</p>
    <p class="text-body text-body mb-10">
      The page you're looking for doesn't exist or has been moved.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/pt/"
        class="btn btn-primary"
        lang="pt-BR"
      >
        Ir para a página inicial (PT)
      </a>
      <a
        href="/en/"
        class="btn btn-secondary"
        lang="en"
      >
        Go to home page (EN)
      </a>
    </div>
  </section>
</BaseLayout>
