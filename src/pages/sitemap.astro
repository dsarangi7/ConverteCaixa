---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';

const title = 'HTML Sitemap | ConverteCaixa';
const description = 'Browse every ConverteCaixa page, including the case converters, bold text generator, and the Portuguese and English information pages.';
const canonical = `${SITE.baseUrl}/sitemap/`;
---

<BaseLayout title={title} description={description} canonical={canonical} lang="en">
  <section class="content-section">
    <div class="max-w-[1200px] mx-auto px-6">
      <h1 class="font-heading-lg text-ink mb-6">HTML Sitemap</h1>
      <div class="prose max-w-3xl">
        <h2>Text tools</h2>
        <ul>
          <li><a href="/en/bold-text-generator/">Bold Text Generator</a></li>
          <li><a href="/pt/gerador-de-texto-negrito/" lang="pt-BR">Gerador de Texto em Negrito</a></li>
          <li><a href="/en/case-converter/">Case Converter</a></li>
          <li><a href="/pt/converter-maiusculas-minusculas/" lang="pt-BR">Converter Maiúsculas e Minúsculas</a></li>
          <li><a href="/en/sentence-case-converter/">Sentence Case Converter</a></li>
          <li><a href="/en/title-case-converter/">Title Case Converter</a></li>
          <li><a href="/en/uppercase-to-lowercase/">Uppercase to Lowercase Converter</a></li>
        </ul>

        <h2>Information</h2>
        <ul>
          <li><a href="/en/">English home page</a></li>
          <li><a href="/pt/" lang="pt-BR">Página inicial em português</a></li>
          <li><a href="/en/about/">About ConverteCaixa</a></li>
          <li><a href="/pt/sobre/" lang="pt-BR">Sobre o ConverteCaixa</a></li>
          <li><a href="/en/contact/">Contact</a></li>
          <li><a href="/pt/contato/" lang="pt-BR">Contato</a></li>
          <li><a href="/en/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/pt/politica-de-privacidade/" lang="pt-BR">Política de Privacidade</a></li>
          <li><a href="/en/terms-and-conditions/">Terms and Conditions</a></li>
          <li><a href="/pt/termos-de-uso/" lang="pt-BR">Termos de Uso</a></li>
          <li><a href="/en/cookie-policy/">Cookie Policy</a></li>
          <li><a href="/pt/politica-de-cookies/" lang="pt-BR">Política de Cookies</a></li>
          <li><a href="/en/accessibility-statement/">Accessibility Statement</a></li>
          <li><a href="/pt/declaracao-de-acessibilidade/" lang="pt-BR">Declaração de Acessibilidade</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
---
